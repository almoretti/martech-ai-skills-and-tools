# nah role to model mapping. Edit freely; no restart needed.
# Anthropic roles run as Claude Code subagents (the plugin's agents/nah-*.md) — change `model:` there.
# pi roles run headless through `pi` (scripts/pi-role.sh) and are configured here.
# Format: provider/model-id and a thinking level (off|minimal|low|medium|high|xhigh).
CODE_REVIEWER_MODEL=openai-codex/gpt-6.1-sol
CODE_REVIEWER_THINKING=high

# Optional: any role can be forced through pi instead of a Claude subagent by
# calling scripts/pi-role.sh <role> with --model. Examples you may want:
#   pi-role.sh oracle --model openai-codex/gpt-5.5 "Task: ..."
#   pi-role.sh contrarian --model anthropic/claude-fable-5-1 "Task: ..."
ORACLE_MODEL=anthropic/claude-opus-5-5
ORACLE_THINKING=high
CONTRARIAN_MODEL=anthropic/claude-opus-5-5
CONTRARIAN_THINKING=high
DIFF_SUMMARIZER_MODEL=anthropic/claude-sonnet-4-6
DIFF_SUMMARIZER_THINKING=medium
